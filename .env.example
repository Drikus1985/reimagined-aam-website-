# --- Database ---
# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aam"

# --- Site ---
# Public origin of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin ---
# Password for /admin (basic session auth). Set a strong value in production.
ADMIN_PASSWORD=""
# Secret used to sign admin session cookies
SESSION_SECRET=""

# --- AI specialist ---
# "anthropic" uses the Claude API; "mock" runs a deterministic offline provider (dev/tests)
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# --- PayFast ---
# Sandbox test credentials: https://developers.payfast.co.za (defaults below are PayFast's public sandbox pair)
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="46f0cd694581a"
# Optional passphrase (must match the value configured in your PayFast account)
PAYFAST_PASSPHRASE=""
# "true" targets sandbox.payfast.co.za; "false" targets www.payfast.co.za
PAYFAST_SANDBOX="true"

# --- The Courier Guy (Shiplogic) ---
# Leave the key empty to fall back to configurable flat-rate quotes
COURIER_GUY_API_KEY=""
COURIER_GUY_API_URL="https://api.shiplogic.com/v2"

# --- Email notifications (optional) ---
# Leave SMTP_HOST empty to disable email entirely (sends become audited no-ops).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="All American Muscle <parts@allamericanmuscle.co.za>"
# Staff inboxes for order/lead notifications (fall back to SMTP_FROM)
ORDERS_NOTIFY_EMAIL=""
LEADS_NOTIFY_EMAIL=""

# --- WooCommerce import (optional) ---
# Used by scripts/import-woocommerce-api.ts when the store owner supplies API credentials
WOO_BASE_URL="https://allamericanmuscle.co.za"
WOO_CONSUMER_KEY=""
WOO_CONSUMER_SECRET=""
